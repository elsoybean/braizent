# Copy to .env (gitignored) and fill in. Never commit real secrets.

# Bring! login. If you signed up with Google/Apple/Facebook, set a password first:
#   Bring app: Profile > More settings > Change password
BRING_EMAIL=you@example.com
BRING_PASSWORD=your-bring-password

# Target Bring! list name (omit to use your first list)
BRING_LIST=Groceries

# Paths (defaults shown; override if your layout differs)
COOK_DIR=/home/pi/meal-planning/cook
AISLE_CONF=/home/pi/meal-planning/cook/aisle.conf
PANTRY_CONF=/home/pi/meal-planning/cook/pantry.conf
